<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_ra" model="ir.ui.view">
        <field name="name">account.payment.form.ra</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="ra_is_advance" invisible="payment_type != 'inbound' or partner_type != 'customer'"/>
                <field name="ra_sale_order_id" invisible="not ra_is_advance"
                       domain="[('partner_id', 'child_of', partner_id)]"/>
            </xpath>
        </field>
    </record>
</odoo>
