<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ra" model="ir.ui.view">
        <field name="name">account.move.form.ra</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Retention &amp; Advance" name="ra_page" invisible="move_type != 'out_invoice'">
                    <group>
                        <group string="Retention">
                            <field name="ra_retention_pct" readonly="state != 'draft'"/>
                            <field name="ra_retention_amount"/>
                            <field name="ra_handover_date" readonly="state != 'draft'"/>
                        </group>
                        <group string="Advance Recovery">
                            <field name="ra_advance_payment_id" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="ra_recovery_type" readonly="state != 'draft'" widget="radio"/>
                            <field name="ra_recovery_pct" readonly="state != 'draft'"
                                   invisible="ra_recovery_type != 'percent'"/>
                            <field name="ra_recovery_fixed" readonly="state != 'draft'"
                                   invisible="ra_recovery_type != 'fixed'"/>
                            <field name="ra_recovery_amount"/>
                        </group>
                    </group>
                    <group>
                        <group string="Summary">
                            <field name="amount_total" string="Invoice Total"/>
                            <field name="ra_retention_amount" string="Less: Retention"/>
                            <field name="ra_recovery_amount" string="Less: Advance Recovery"/>
                            <field name="ra_amount_to_pay" class="fw-bold"/>
                            <field name="ra_retention_released" invisible="state == 'draft'"/>
                            <field name="ra_retention_held" invisible="state == 'draft'"/>
                            <field name="ra_project_id"/>
                        </group>
                    </group>
                    <field name="ra_helper_move_ids" readonly="1" invisible="state == 'draft'">
                        <list>
                            <field name="date"/>
                            <field name="name"/>
                            <field name="ra_kind"/>
                            <field name="company_currency_id" column_invisible="1"/>
                            <field name="ra_amount"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
