<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ra" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ra</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Retention &amp; Advance" name="ra_settings_block">
                    <setting string="Retention Receivable Account"
                             help="Reconcilable account where the retention held by the customer is booked.">
                        <field name="ra_retention_account_id"/>
                    </setting>
                    <setting string="Default Retention %"
                             help="Pre-filled on new customer invoices.">
                        <field name="ra_default_retention_pct"/>
                    </setting>
                    <setting string="Retention Journal"
                             help="Miscellaneous journal for the retention / advance entries (optional).">
                        <field name="ra_journal_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
